{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tagline flow",
  "description": "Speech-by-speech argument sheets. Runtime validation also checks that each row has exactly as many cells as its sheet has columns.",
  "type": "object",
  "required": [
    "version",
    "sheets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "default": 1
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "columns",
          "rows"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}