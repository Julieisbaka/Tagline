{
  "name": "tagline",
  "productName": "Tagline",
  "version": "0.0.1",
  "description": "Obsidian-style knowledge vault for policy debaters",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "start": "vite build && electron .",
    "test": "node --test tests/core.test.cjs tests/features.test.cjs tests/canvas.test.cjs tests/ui-system.test.cjs tests/improvements.test.cjs tests/productivity.test.cjs tests/search.test.cjs tests/calibration.test.cjs tests/nli.test.cjs tests/startup.test.cjs tests/release.test.cjs",
    "test:startup": "vite build && node tests/startup-smoke.cjs",
    "test:installation": "node tests/installation-smoke.cjs",
    "test:electron": "vite build && electron tests/electron-smoke.cjs",
    "test:semantic": "node tests/semantic-smoke.cjs",
    "test:search": "vite build && node tests/search-smoke.cjs",
    "test:features": "vite build && electron tests/features-smoke.cjs",
    "test:canvas": "vite build && node tests/canvas-smoke.cjs",
    "icons": "electron scripts/generate-icons.cjs",
    "test:speech": "vite build && electron tests/speech-smoke.cjs",
    "test:profile": "vite build && node tests/profile-smoke.cjs",
    "test:improvements": "vite build && node tests/improvements-smoke.cjs",
    "test:productivity": "vite build && node tests/productivity-smoke.cjs",
    "test:extensions": "vite build && node tests/extensions-smoke.cjs",
    "test:settings": "vite build && node tests/settings-smoke.cjs",
    "test:nli": "node tests/nli-smoke.cjs",
    "test:nli-ui": "vite build && node tests/nli-ui-smoke.cjs",
    "test:layout": "vite build && node tests/layout-smoke.cjs",
    "test:a11y": "vite build && node tests/accessibility-smoke.cjs"
  },
  "license": "MIT",
  "build": {
    "appId": "app.tagline",
    "productName": "Tagline",
    "artifactName": "Tagline-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/lib/keybindings.json",
      "src/lib/defaultSettings.json",
      "build/icon.*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "flow",
        "name": "Tagline Debate Flow",
        "description": "Tagline debate flow document",
        "mimeType": "application/x-tagline-flow",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@huggingface/transformers": "^4.3.1",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-find-and-replace": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "syllable": "^5.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.5.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}