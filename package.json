{
  "name": "tagline",
  "productName": "Tagline",
  "version": "0.0.5-dev",
  "type": "module",
  "description": "Obsidian-style knowledge vault for policy debaters",
  "main": "electron/main.cjs",
  "author": {
    "name": "JulieISBaka"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "start": "vite build && electron .",
    "test": "node --test --test-reporter=tap \"tests/*.test.cjs\"",
    "test:all": "node scripts/run-all-tests.cjs",
    "test:shared": "node --test --test-skip-pattern=^platform: \"tests/*.test.cjs\"",
    "test:platform": "node --test --test-name-pattern=^platform: \"tests/*.test.cjs\"",
    "test:canvas-performance": "node scripts/run-smoke.cjs node tests/canvas-performance-smoke.cjs",
    "test:opencaselist": "node scripts/run-smoke.cjs node tests/opencaselist-smoke.cjs",
    "test:tabroom": "node scripts/run-smoke.cjs node tests/tabroom-smoke.cjs",
    "test:startup": "node scripts/run-smoke.cjs node tests/startup-smoke.cjs",
    "test:installation": "node tests/installation-smoke.cjs",
    "test:google-docs": "node scripts/run-smoke.cjs node tests/google-docs-smoke.cjs",
    "test:electron": "node scripts/run-smoke.cjs electron tests/electron-smoke.cjs",
    "test:semantic": "node tests/semantic-smoke.cjs",
    "test:search": "node scripts/run-smoke.cjs node tests/search-smoke.cjs",
    "test:features": "node scripts/run-smoke.cjs electron tests/features-smoke.cjs",
    "test:canvas": "node scripts/run-smoke.cjs node tests/canvas-smoke.cjs",
    "icons": "electron scripts/generate-icons.cjs",
    "test:speech": "node scripts/run-smoke.cjs node tests/speech-smoke.cjs",
    "test:localization": "node scripts/run-smoke.cjs node tests/localization-smoke.cjs",
    "test:profile": "node scripts/run-smoke.cjs node tests/profile-smoke.cjs",
    "test:improvements": "node scripts/run-smoke.cjs node tests/improvements-smoke.cjs",
    "test:productivity": "node scripts/run-smoke.cjs node tests/productivity-smoke.cjs",
    "test:extensions": "node scripts/run-smoke.cjs node tests/extensions-smoke.cjs",
    "test:settings": "node scripts/run-smoke.cjs node tests/settings-smoke.cjs",
    "test:nli": "node tests/nli-smoke.cjs",
    "test:nli-ui": "node scripts/run-smoke.cjs node tests/nli-ui-smoke.cjs",
    "test:layout": "node scripts/run-smoke.cjs node tests/layout-smoke.cjs",
    "test:interactions": "node scripts/run-smoke.cjs node tests/interactions-smoke.cjs",
    "test:a11y": "node scripts/run-smoke.cjs node tests/accessibility-smoke.cjs"
  },
  "license": "MIT",
  "build": {
    "appId": "app.tagline",
    "productName": "Tagline",
    "artifactName": "Tagline-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "schemas/**/*",
      "src/lib/keybindings.json",
      "src/lib/defaultSettings.json",
      "build/icon.*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/*/!(${arch})/**/*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "flow",
        "name": "Tagline Debate Flow",
        "description": "Tagline debate flow document",
        "mimeType": "application/x-tagline-flow",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/!(win32)/**/*"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/!(darwin)/**/*"
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/!(linux)/**/*"
      ]
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@huggingface/transformers": "^4.3.2",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-find-and-replace": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "syllable": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}