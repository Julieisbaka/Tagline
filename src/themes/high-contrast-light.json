{
  "version": 1,
  "id": "high-contrast-light",
  "name": "High contrast light",
  "mode": "light",
  "metadata": {
    "accessibility": {
      "contrast": "high"
    }
  },
  "colors": {
    "bg": "#ffffff",
    "bg-secondary": "#ffffff",
    "bg-elevated": "#ffffff",
    "bg-hover": "#eeeeee",
    "border": "#000000",
    "text": "#000000",
    "text-strong": "#000000",
    "text-muted": "#202020",
    "text-faint": "#303030",
    "accent": "#000080",
    "accent-text": "#ffffff",
    "accent-dim": "#e3e3ff",
    "selection": "#c9c9ff",
    "selection-text": "#000000",
    "highlight-bg": "#000000",
    "highlight-text": "#ffffff",
    "code": "#000000",
    "h1": "#000000",
    "h2": "#000080",
    "h3": "#003050",
    "h4": "#000000",
    "aff": "#003066",
    "neg": "#65001a",
    "aff-bg": "#edf6ff",
    "neg-bg": "#fff0f4",
    "danger": "#65001a",
    "warning": "#503000",
    "shadow": "#00000080",
    "backdrop": "#00000099",
    "button-bg": "#eeeeee",
    "button-text": "#000000",
    "button-border": "#000000",
    "button-primary-bg": "#000080",
    "button-primary-text": "#ffffff",
    "input-bg": "#ffffff",
    "input-text": "#000000",
    "input-border": "#000000",
    "input-placeholder": "#303030",
    "sidebar-bg": "#ffffff",
    "sidebar-text": "#000000",
    "tab-bg": "#ffffff",
    "tab-active-bg": "#eeeeee",
    "tab-active-text": "#000000",
    "tab-hover-bg": "#eeeeee",
    "focus-ring": "#000080",
    "disabled-text": "#808080",
    "disabled-bg": "#f5f5f5",
    "success": "#005a20",
    "link": "#000080",
    "link-hover": "#000060"
  },
  "pairings": [
    { "id": "body", "fg": "text", "bg": "bg", "minRatio": 4.5 },
    { "id": "strong", "fg": "text-strong", "bg": "bg-elevated", "minRatio": 4.5 },
    { "id": "muted", "fg": "text-muted", "bg": "bg", "minRatio": 4.5 },
    { "id": "accent-control", "fg": "accent-text", "bg": "accent", "minRatio": 3 },
    { "id": "primary-button", "fg": "button-primary-text", "bg": "button-primary-bg", "minRatio": 3 },
    { "id": "button", "fg": "button-text", "bg": "button-bg", "minRatio": 4.5 },
    { "id": "input", "fg": "input-text", "bg": "input-bg", "minRatio": 4.5 },
    { "id": "sidebar", "fg": "sidebar-text", "bg": "sidebar-bg", "minRatio": 4.5 },
    { "id": "tab-active", "fg": "tab-active-text", "bg": "tab-active-bg", "minRatio": 4.5 },
    { "id": "selection", "fg": "selection-text", "bg": "selection", "minRatio": 3 },
    { "id": "link", "fg": "link", "bg": "bg", "minRatio": 4.5 }
  ]
}
