{
  "version": 1,
  "id": "high-contrast-dark",
  "name": "High contrast dark",
  "mode": "dark",
  "metadata": {
    "accessibility": {
      "contrast": "high"
    }
  },
  "colors": {
    "bg": "#000000",
    "bg-secondary": "#000000",
    "bg-elevated": "#000000",
    "bg-hover": "#202020",
    "border": "#ffffff",
    "text": "#ffffff",
    "text-strong": "#ffffff",
    "text-muted": "#eeeeee",
    "text-faint": "#dddddd",
    "accent": "#ffff00",
    "accent-text": "#000000",
    "accent-dim": "#262600",
    "selection": "#464600",
    "selection-text": "#ffffff",
    "highlight-bg": "#ffff00",
    "highlight-text": "#000000",
    "code": "#ffffff",
    "h1": "#ffffff",
    "h2": "#ffff00",
    "h3": "#80ffff",
    "h4": "#ffffff",
    "aff": "#80dfff",
    "neg": "#ffb3c1",
    "aff-bg": "#00151e",
    "neg-bg": "#200009",
    "danger": "#ffb3c1",
    "warning": "#ffff00",
    "shadow": "#ffffff40",
    "backdrop": "#000000cc",
    "button-bg": "#202020",
    "button-text": "#ffffff",
    "button-border": "#ffffff",
    "button-primary-bg": "#ffff00",
    "button-primary-text": "#000000",
    "input-bg": "#000000",
    "input-text": "#ffffff",
    "input-border": "#ffffff",
    "input-placeholder": "#dddddd",
    "sidebar-bg": "#000000",
    "sidebar-text": "#ffffff",
    "tab-bg": "#000000",
    "tab-active-bg": "#202020",
    "tab-active-text": "#ffffff",
    "tab-hover-bg": "#202020",
    "focus-ring": "#ffff00",
    "disabled-text": "#808080",
    "disabled-bg": "#101010",
    "success": "#80ff80",
    "link": "#80ffff",
    "link-hover": "#ffffff"
  },
  "pairings": [
    { "id": "body", "fg": "text", "bg": "bg", "minRatio": 4.5 },
    { "id": "strong", "fg": "text-strong", "bg": "bg-elevated", "minRatio": 4.5 },
    { "id": "muted", "fg": "text-muted", "bg": "bg", "minRatio": 4.5 },
    { "id": "accent-control", "fg": "accent-text", "bg": "accent", "minRatio": 3 },
    {
      "id": "primary-button",
      "fg": "button-primary-text",
      "bg": "button-primary-bg",
      "minRatio": 3
    },
    { "id": "button", "fg": "button-text", "bg": "button-bg", "minRatio": 4.5 },
    { "id": "input", "fg": "input-text", "bg": "input-bg", "minRatio": 4.5 },
    { "id": "sidebar", "fg": "sidebar-text", "bg": "sidebar-bg", "minRatio": 4.5 },
    { "id": "tab-active", "fg": "tab-active-text", "bg": "tab-active-bg", "minRatio": 4.5 },
    { "id": "selection", "fg": "selection-text", "bg": "selection", "minRatio": 3 },
    { "id": "link", "fg": "link", "bg": "bg", "minRatio": 4.5 }
  ]
}
